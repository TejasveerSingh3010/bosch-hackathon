# Copy this file to .env and fill in. NEVER commit .env
# The remediation agent uses LLM_API_KEY (Groq). Agent 2 (the reporter) uses a deterministic stand-in
# for the LLM (see agents/llm.py); fill in LLM_PROVIDER / LLM_MODEL when the real client is wired in
# (search the code for TODO(llm)).
LLM_API_KEY=your-key-here
LLM_PROVIDER=
LLM_MODEL=
# Langfuse tracing for `python -m agents` (and the remediation CLI). Leave unset to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
