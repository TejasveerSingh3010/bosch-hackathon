# Copy this file to .env and fill in. NEVER commit .env
#
# Phase 1 runs entirely offline: leave all three blank and the agents rank, report and recommend
# deterministically (agents/llm.get_client() returns None when LLM_API_KEY is empty). Fill all
# three in later to wire in the real LLM behind the same interface.

LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
