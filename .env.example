# Copy this file to .env and fill in. NEVER commit .env
# LLM_API_KEY is a Groq key, used by the remediation agent (openai/gpt-oss-120b) and by Agent 2, the
# reporter (openai/gpt-oss-20b; LLM_MODEL overrides it). Without a key the reporter uses its rules.
LLM_API_KEY=your-key-here
LLM_PROVIDER=
LLM_MODEL=
# Langfuse tracing for `python -m agents` (and the remediation CLI). Leave unset to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
