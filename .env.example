# Copy this file to .env and fill in. NEVER commit .env
#
# No spaces around '=' (LLM_PROVIDER=gemini, not LLM_PROVIDER= gemini). Quotes are optional.
#
# Phase 1 runs entirely offline: leave LLM_API_KEY blank and the agents rank, report and
# recommend deterministically (agents/llm.get_client() returns None when LLM_API_KEY is empty).
# Fill it in to use a real model behind the same interface.

# --- Primary provider ---------------------------------------------------------
# Supported LLM_PROVIDER values: gemini (Google AI Studio) or groq.
#   gemini -> key from https://aistudio.google.com/apikey ; e.g. LLM_MODEL=gemini-3.8-flash
#   groq   -> key from https://console.groq.com/keys      ; e.g. LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash

# --- Optional fallback provider -----------------------------------------------
# If set, the agents fail over to this provider on a rate limit (HTTP 429) or an unavailable
# server, then to the deterministic path if it also fails - so a demo never blocks. Leave the
# key blank to disable failover. A good pairing is gemini primary + groq fallback.
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
